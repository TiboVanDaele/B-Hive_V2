<header>
	<a href="/home" class="logo-link">
		<picture>
			<source media="(max-width: 600px)" srcset="/images/b-hive.png">
			<img class="logo" src="/images/b-hive-lg.png" alt="B-Hive logo" />
		</picture>
	</a>

	<% if (searchbar) { %>
	<div class="searchbar">
		<form action="/home" method="GET">
			<input class="ring-focus" type="search" name="q" placeholder="Zoek een game...">

				<div class="button-group">
					<button type="button" class="button-l ring-hover">
						Filter
					</button>
					<button type="submit" class="button-r ring-hover">
						<i class="fa-solid fa-magnifying-glass fa-xs"></i>
						Zoeken
					</button>
				</div>
			</form>
		</div>
		<% } %>
			<nav class="user-nav" aria-label="Gebruikersmenu">
				<!--TO DO: replace avatar image with user image -->
				<div class="user">
					<img class="avatar"
						src="https://api.dicebear.com/9.x/glass/svg?backgroundColor=4762eb,477eeb,4799eb,47b4eb,47d0eb,47eb47,47eb62,47eb7e,47eb99,47ebb4,47ebd0,47ebeb,6247eb,62eb47,7e47eb,7eeb47,9947eb,99eb47,b447eb,b4eb47,d047eb,d0eb47,eb4762,eb477e,eb4799,eb47d0,eb47eb,ebeb47,ebd047&backgroundType=gradientLinear&seed=Alexanderhttps://api.dicebear.com/9.x/glass/svg?backgroundColor=4762eb,477eeb,4799eb,47b4eb,47d0eb,47eb47,47eb62,47eb7e,47eb99,47ebb4,47ebd0,47ebeb,6247eb,62eb47,7e47eb,7eeb47,9947eb,99eb47,b447eb,b4eb47,d047eb,d0eb47,eb4762,eb477e,eb4799,eb47d0,eb47eb,ebeb47,ebd047&backgroundType=gradientLinear&seed=Alexander"
						alt="">
					<a href="/account" class="username">username</a>
				</div>

				<details class="dropdown">
					<summary class="dropdown-toggle">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5"
							stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
						</svg>
					</summary>

					<ul class="dropdown-menu">
						<li>
							<a href="/account">Instellingen</a>
						</li>
						<li>
							<a href="/login">Uitloggen</a>
						</li>
