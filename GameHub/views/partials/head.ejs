<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no">
    <% if (typeof(collection) != "undefined") { %>
    <title>
    	<%= collection.name %>
    </title>
    <% } else { %>
    <title>
    	<%= title %>
    </title>
    <% } %>
    <script src="https://kit.fontawesome.com/de97115803.js" crossorigin="anonymous"></script>
    <script defer src="/js/aside-nav.js"></script>
    <link rel="stylesheet" href="/css/reset.css">
    <link rel="stylesheet" href="/css/footer.css">

    <% if (typeof(collection) != "undefined") { %>
    <!--<link rel="stylesheet" href="/css/collections.css">-->
    <% } %>

    <% if (page == "gamedetails") { %>
    <script defer src="/js/set-current-game.js"></script>
    <% } %>
    
    <% if (page != "login" && page != "index") { %>
    <link rel="stylesheet" href="/css/header.css">
    <link rel="stylesheet" href="/css/aside.css">
    <% } %>

    <link rel="stylesheet" href="/css/<%= page %>.css">

    <% if (page == "home") { %>
    <link rel="stylesheet" href="/css/home.css">
    <script defer src="/js/compare-bar.js"></script>
    <% } %>

    <% if (page == "home" || page == "gamedetails") { %>
    <script defer src="/js/add-to-collection.js"></script>
    <% } %>

    <% if (page != "account" ||page != "stattracker" ) { %>
     <script defer src="/js/autocomplete.js"></script>
    <% } %>

    <% if (page == "compare" || page == "gamedetails") { %>
    <script defer src="/js/show-more-less.js"></script>
    <% } %>

    <link rel="stylesheet" href="/css/style.css">
</head>