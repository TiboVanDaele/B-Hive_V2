<!DOCTYPE html>
<html lang="nl-BE">
<%- include("partials/head", {page:"home", title:"GameHub"}) %>

	<body>
		<%- include("partials/header", { searchbar: true }) %>
					<main class="home-main">
										<%- include("partials/aside", { showFilters: true }) %>
						<div class="home-wrapper">
							<h1 class="title">Games ontdekken</h1>

							<section class="home-grid">
								<% games.forEach(game=> { %>
									<article class="game-card">
										<div class="card-actions">
											<button class="add-btn" type="button">Add</button>

											<button class="compare-btn" type="button" data-name="<%= game.name %>"
												data-image="<%= game.image %>" data-slug="<%= game.slug %>">
												Compare
											</button>
										</div>

										<a href="/game/<%= game.slug %>">

											<img src="<%= game.image %>" alt="<%= game.name %>">
											<div class="game-card-content">
												<h2>
													<%= game.name %>
												</h2>
												<p>⭐ <%= game.rating %>
												</p>
												<p>
													<%= game.released %>
												</p>
											</div>
										</a>
									</article>
									<% }) %>
							</section>
						</div>

						<a href="/game/<%= game.slug %>">
							<img src="<%= game.image %>" alt="<%= game.name %>">
							<h2><%= game.name %></h2>
							<p>⭐ <%= game.rating %></p>
							<p><%= game.released %></p>
						</a>
					</article>
					<% }) %>
				</section>
				<nav class="pagination" aria-label="Paginering">
					<% if (hasPrev) { %>
						<a href="/home?page=<%= currentPage - 1 %><%= search ? '&q=' + search : '' %><%= activeGenres.length ? '&genres=' + activeGenres.join(',') : '' %>" aria-label="Vorige pagina">← Vorige</a>
					<% } %>
					<p aria-current="page">Pagina <%= currentPage %></p>
					<% if (hasNext) { %>
						<a href="/home?page=<%= currentPage + 1 %><%= search ? '&q=' + search : '' %><%= activeGenres.length ? '&genres=' + activeGenres.join(',') : '' %>" aria-label="Volgende pagina">Volgende →</a>
					<% } %>
				</nav>
			</div>
		</main>
	</div>

	<section class="compare-bar" id="compareBar">
		<div class="compare-slot" data-slot="0">
			<p>Game 1</p>
		</div>

		<div class="compare-slot" data-slot="1">
			<p>Game 2</p>
		</div>

		<a href="/compare" class="compare-page-btn" id="comparePageBtn">
			Vergelijk
		</a>
	</section>

	<%- include("partials/footer") %>
</body>

</html>